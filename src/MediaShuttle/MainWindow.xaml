<Window
    x:Class="MediaShuttle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Margin="14,0,160,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox x:Name="AppLogo" Width="28" Height="19" VerticalAlignment="Center" AutomationProperties.Name="Fast media card logo">
                <Canvas Width="76" Height="48">
                    <Line X1="2" Y1="13" X2="25" Y2="13" Stroke="{ThemeResource SpeedRedBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line X1="7" Y1="24" X2="25" Y2="24" Stroke="{ThemeResource SpeedRedBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line X1="13" Y1="35" X2="25" Y2="35" Stroke="{ThemeResource SpeedRedBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M30,3 L56,3 L71,18 L71,45 L30,45 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Path Data="M56,3 L56,18 L71,18" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="3" Fill="Transparent" />
                    <Rectangle Canvas.Left="39" Canvas.Top="29" Width="5" Height="10" Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                    <Rectangle Canvas.Left="48" Canvas.Top="29" Width="5" Height="10" Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                    <Rectangle Canvas.Left="57" Canvas.Top="29" Width="5" Height="10" Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                </Canvas>
            </Viewbox>

            <TextBlock x:Name="AppNameText" Grid.Column="1" Text="MEDIA SHUTTLE" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" CharacterSpacing="60" VerticalAlignment="Center" Margin="9,0,0,0" />

            <Border x:Name="StatusPill" Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="10" Padding="8,3" Margin="14,0,0,0" AutomationProperties.Name="Media status" AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TopStatusText" Text="WAITING FOR MEDIA" Style="{StaticResource BadgeTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button x:Name="SettingsButton" Grid.Column="4" Width="28" Height="28" Padding="0" Margin="10,0,10,0" VerticalAlignment="Center" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Open settings">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="310" Spacing="16" Padding="4,5,4,4">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Transfer behavior and appearance" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabelStyle}" />
                                <ComboBox x:Name="ThemeComboBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Application theme">
                                    <ComboBoxItem Content="Use Windows setting" Tag="System" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                </ComboBox>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <ToggleSwitch x:Name="AutoTransferToggle" Header="Automatic transfer" OffContent="Off" OnContent="On" />
                            <ToggleSwitch x:Name="GroupByDateToggle" Header="Date folders" OffContent="Flat folders" OnContent="YYYY-MM-DD" />
                            <ToggleSwitch x:Name="NotificationsToggle" Header="Completion notifications" OffContent="Off" OnContent="On" />
                            <ToggleSwitch x:Name="ActivityToggle" Header="Activity log" OffContent="Hidden" OnContent="Shown" />
                            <ToggleSwitch x:Name="StartupToggle" Header="Start with Windows" OffContent="Off" OnContent="On" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE713;" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainLayout" MaxWidth="1220" Padding="24,22,24,26" ColumnSpacing="22" RowSpacing="18" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SourceColumn" Width="240" />
                    <ColumnDefinition x:Name="OperationsColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="SourcePanel" Grid.Column="0" Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="18" AutomationProperties.Name="Source media summary">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="26" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="26" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="SOURCE" Style="{StaticResource SectionLabelStyle}" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,13,0,0" VerticalAlignment="Top">
                            <Grid Width="34" Height="44" AutomationProperties.Name="Camera media card icon">
                                <Path Data="M4,2 L27,2 L34,9 L34,42 L4,42 Z" Fill="{ThemeResource ControlFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                                <Path Data="M27,2 L27,9 L34,9" Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" />
                                <Line X1="8" Y1="9" X2="8" Y2="30" Stroke="{ThemeResource SpeedRedBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <StackPanel Orientation="Horizontal" Spacing="1" Margin="14,0,0,7" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                    <Rectangle Width="2" Height="6" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Rectangle Width="2" Height="6" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Rectangle Width="2" Height="6" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Rectangle Width="2" Height="6" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="3" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock x:Name="CardLabelText" Text="No card connected" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CardDetailText" Text="Insert a camera card or connect camera storage to begin." FontFamily="Consolas" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CardStatsText" Text="—" FontFamily="Consolas" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Grid.Row="2" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                        <StackPanel Grid.Row="3" Spacing="8">
                            <TextBlock Text="CARD CONTENTS" Style="{StaticResource SectionLabelStyle}" />
                            <Grid x:Name="CardContentsBar" Height="6" ColumnSpacing="1" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="JpegSegmentColumn" Width="1*" />
                                    <ColumnDefinition x:Name="RawSegmentColumn" Width="1*" />
                                    <ColumnDefinition x:Name="OtherSegmentColumn" Width="1*" />
                                    <ColumnDefinition x:Name="VideoSegmentColumn" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="{ThemeResource MediaKindJpegBrush}" />
                                <Rectangle Grid.Column="1" Fill="{ThemeResource MediaKindRawBrush}" />
                                <Rectangle Grid.Column="2" Fill="{ThemeResource MediaKindOtherBrush}" />
                                <Rectangle Grid.Column="3" Fill="{ThemeResource MediaKindVideoBrush}" />
                            </Grid>
                            <StackPanel>
                                <Grid ColumnSpacing="6" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="7" Height="7" Fill="{ThemeResource MediaKindJpegBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="JPEG" FontFamily="Consolas" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" />
                                    <TextBlock x:Name="JpegCountText" Grid.Column="2" Text="0" FontFamily="Consolas" FontSize="10.5" />
                                </Grid>
                                <Grid ColumnSpacing="6" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="7" Height="7" Fill="{ThemeResource MediaKindRawBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="RAW" FontFamily="Consolas" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" />
                                    <TextBlock x:Name="RawCountText" Grid.Column="2" Text="0" FontFamily="Consolas" FontSize="10.5" />
                                </Grid>
                                <Grid ColumnSpacing="6" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="7" Height="7" Fill="{ThemeResource MediaKindOtherBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="OTHER" FontFamily="Consolas" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" />
                                    <TextBlock x:Name="OtherCountText" Grid.Column="2" Text="0" FontFamily="Consolas" FontSize="10.5" />
                                </Grid>
                                <Grid ColumnSpacing="6" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="7" Height="7" Fill="{ThemeResource MediaKindVideoBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="VIDEO" FontFamily="Consolas" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" />
                                    <TextBlock x:Name="VideoCountText" Grid.Column="2" Text="0" FontFamily="Consolas" FontSize="10.5" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Grid.Row="4" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                        <StackPanel Grid.Row="5" Spacing="9">
                            <TextBlock Text="DESTINATION" Style="{StaticResource SectionLabelStyle}" />
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <TextBlock x:Name="DestinationText" Text="Desktop\Camera" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Destination folder path" />
                            </Border>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ChangeDestinationButton" HorizontalAlignment="Stretch" Height="42" AutomationProperties.Name="Choose destination folder">
                                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                                        <TextBlock Text="Choose" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenFolderButton" Grid.Column="1" HorizontalAlignment="Stretch" Height="42" AutomationProperties.Name="Open destination folder">
                                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                        <TextBlock Text="Open" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock FontFamily="Consolas" FontSize="10" LineHeight="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Photos\JPEGs&#10;Photos\RAWs&#10;Photos\Other&#10;Videos" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="OperationsPanel" Grid.Column="1" Grid.Row="0" RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" AutomationProperties.LiveSetting="Assertive" />

                    <Grid Grid.Row="1" ColumnSpacing="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="226" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="12">
                            <TextBlock Text="VERIFIED CAMERA INGEST" Style="{StaticResource SectionLabelStyle}" Foreground="{ThemeResource SpeedRedBrush}" />
                            <TextBlock x:Name="HeroTitleText" Text="Ready for your next card." FontSize="36" LineHeight="42" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="HeroSubtitleText" Text="JPEGs, RAWs, and video are sorted automatically. Every file is SHA-256 verified before erase is available." FontSize="15" LineHeight="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="670" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Bottom">
                            <Button x:Name="TransferButton" Content="Scan for media" Style="{StaticResource PrimaryTransferButtonStyle}" HorizontalAlignment="Stretch" Height="48" ToolTipService.ToolTip="Copy, sort, and SHA-256 verify media" AutomationProperties.Name="Transfer and verify media" />
                            <Button x:Name="CancelButton" Content="Cancel transfer" HorizontalAlignment="Stretch" Height="44" Visibility="Collapsed" AutomationProperties.Name="Cancel transfer" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="21">
                        <Grid RowSpacing="13">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="THIS SESSION" Style="{StaticResource SectionLabelStyle}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="PhaseText" Text="STANDBY" Style="{StaticResource SectionLabelStyle}" Foreground="{ThemeResource SpeedRedBrush}" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="PercentText" Text="0%" FontFamily="Consolas" FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Height="4" Background="{ThemeResource ControlFillColorDefaultBrush}" AutomationProperties.Name="Transfer progress">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ProgressBeforeColumn" Width="0*" />
                                    <ColumnDefinition x:Name="ProgressFillColumn" Width="0*" />
                                    <ColumnDefinition x:Name="ProgressAfterColumn" Width="100*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="ProgressFillRectangle" Grid.Column="1" />
                            </Grid>
                            <Grid Grid.Row="2" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="COPIED" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock x:Name="CopiedText" Text="0 files" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="ALREADY SAFE" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock x:Name="SkippedText" Text="0 files" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="PROCESSED" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock x:Name="ProcessedText" Text="0 B" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock Text="THROUGHPUT" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock x:Name="ThroughputText" Text="—" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="4">
                                    <TextBlock Text="ELAPSED" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock x:Name="ElapsedText" Text="0:00" FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="3" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CurrentFileText" Text="Waiting for camera media" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="ReportButton" Content="Report" Height="30" IsEnabled="False" ToolTipService.ToolTip="Reveal the verified transfer report" AutomationProperties.Name="Open transfer report" />
                                    <Button x:Name="SessionTransferAgainButton" Content="Transfer again" Height="30" IsEnabled="False" AutomationProperties.Name="Transfer again" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="ActivitySection" Grid.Row="3" Spacing="9">
                        <TextBlock Text="ACTIVITY" Style="{StaticResource SectionLabelStyle}" />
                        <ListView x:Name="ActivityList" Height="88" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="False" AutomationProperties.Name="Recent activity">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,3" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <Border Grid.Row="4" Background="{ThemeResource DangerSurfaceBrush}" BorderBrush="{ThemeResource SpeedRedBrush}" BorderThickness="1" CornerRadius="10" Padding="21" AutomationProperties.Name="Erase card controls">
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="236" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="ERASE CARD CONTENTS" Style="{StaticResource SectionLabelStyle}" Foreground="{ThemeResource SpeedRedBrush}" />
                                    <Border x:Name="EraseLockedBadge" Style="{StaticResource BadgeBorderStyle}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                        <TextBlock Text="LOCKED" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border x:Name="EraseUnlockedBadge" Style="{StaticResource BadgeBorderStyle}" BorderBrush="{ThemeResource SpeedRedBrush}" Visibility="Collapsed">
                                        <TextBlock Text="UNLOCKED" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SpeedRedBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="WipeDescriptionText" Text="Locked until every remaining camera file has a verified destination copy." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="WipeButton" Grid.Column="1" Content="Erase everything on card" IsEnabled="False" Foreground="{ThemeResource SpeedRedBrush}" BorderBrush="{ThemeResource SpeedRedBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="46" ToolTipService.ToolTip="Available only after every media file is verified" AutomationProperties.Name="Erase everything on card" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
