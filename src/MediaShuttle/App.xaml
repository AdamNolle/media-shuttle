<Application
    x:Class="MediaShuttle.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SpeedRed">#FFFF4D44</Color>
            <Color x:Key="SpeedRedHover">#FFE5423A</Color>
            <Color x:Key="SpeedRedPressed">#FFC9342D</Color>
            <SolidColorBrush x:Key="SpeedRedBrush" Color="{StaticResource SpeedRed}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SpeedRed}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource SpeedRedHover}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource SpeedRedPressed}" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#667F7F7F" />
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
